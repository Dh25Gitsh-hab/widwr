# Copy to backend/.env and change only what you need. Every value has a sensible default.

# Purchase-decision window (decisions on D-1 buy for delivery day D)
WFM_FIRST_DECISION_DATE=2026-01-01
WFM_LAST_DECISION_DATE=2026-01-31

# Default decision cutoff, UK local time on D-1 (Nord Pool GB day-ahead gate closure)
WFM_DEFAULT_GATE_CLOSURE=09:50

# snapshot = use backend/data/*.csv (download once if missing) | live = always download at start-up
WFM_DATA_SOURCE=snapshot

# Browser origins allowed to call the API (JSON list)
WFM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default model per ML component: approved defaults shown (the other model is served for comparison)
# WFM_ML_DEFAULT_REGRESSOR=linear_by_level     # or random_forest
# WFM_ML_DEFAULT_CLASSIFIER=logistic_by_level  # or random_forest

# Elexon API tuning
# WFM_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# WFM_ELEXON_TIMEOUT_SECONDS=60
# WFM_ELEXON_MAX_RETRIES=3
# WFM_ELEXON_CHUNK_DAYS=7
